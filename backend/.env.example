DATABASE_URL=sqlite:///./control_acceso.db
# Obligatorio: 32+ caracteres aleatorios. El backend no arranca con un valor de ejemplo.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
QR_TTL_SECONDS=45
# Tolerancia de reloj del QR (lo fecha el telefono) y clave publica del Registro Civil simulado
QR_CLOCK_SKEW_SECONDS=5
ISSUER_PUBLIC_KEY_FILE=registro_civil_sim/issuer_public.key
QR_CONFIRM_WINDOW_SECONDS=60
